<powershell>
# First boot of the RichView Windows walk's machine. The keys below were made for this one run: the
# public key that may log in, and the machine's own SSH host key.
$ErrorActionPreference = 'Continue'
# The limit: three hours after first boot the machine shuts down, and it was started so that a
# shutdown terminates it. A scheduled task survives a restart; a plain shutdown timer does not.
$at = (Get-Date).AddMinutes(16)
Register-ScheduledTask -TaskName 'richview-build-limit' -User 'SYSTEM' -RunLevel Highest -Force `
  -Trigger (New-ScheduledTaskTrigger -Once -At $at) `
  -Action (New-ScheduledTaskAction -Execute 'shutdown.exe' -Argument '/s /f /t 0')
"limit at $at" | Set-Content C:\richview-build-limit.txt
# SSH for the one key of this run, into PowerShell.
if (-not (Get-Service sshd -ErrorAction SilentlyContinue)) { Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 }
# The host key the run made and pinned, written before sshd first starts, so the walk knows the
# machine it reaches instead of trusting the first answer. It is good for this machine's life only.
$hostKey = @'
@HOST_KEY@
'@
New-Item -ItemType Directory -Path C:\ProgramData\ssh -Force | Out-Null
[IO.File]::WriteAllText('C:\ProgramData\ssh\ssh_host_ed25519_key', ($hostKey.Trim() -replace "`r`n", "`n") + "`n")
[IO.File]::WriteAllText('C:\ProgramData\ssh\ssh_host_ed25519_key.pub', '@HOST_PUBLIC_KEY@' + "`n")
icacls C:\ProgramData\ssh\ssh_host_ed25519_key /inheritance:r /grant 'SYSTEM:F' /grant 'Administrators:F'
Set-Service sshd -StartupType Automatic
Start-Service sshd
Set-Content -Path C:\ProgramData\ssh\administrators_authorized_keys -Value '@PUBLIC_KEY@' -Encoding ascii
icacls C:\ProgramData\ssh\administrators_authorized_keys /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F'
New-Item -Path 'HKLM:\SOFTWARE\OpenSSH' -Force | Out-Null
New-ItemProperty -Path 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -Value 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe' -PropertyType String -Force
if (-not (Get-NetFirewallRule -Name 'richview-sshd' -ErrorAction SilentlyContinue)) {
  New-NetFirewallRule -Name 'richview-sshd' -DisplayName 'OpenSSH for the RichView build' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 -Profile Any
}
Restart-Service sshd
New-Item -ItemType Directory -Path C:\rv -Force | Out-Null
</powershell>
