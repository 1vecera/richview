{
  "version": 1,
  "areas": [
    {
      "name": "all changed files",
      "paths": [
        "*"
      ],
      "steps": [
        "secrets"
      ]
    },
    {
      "name": "chart engine",
      "paths": [
        "richview-chart/"
      ],
      "steps": [
        "fmt",
        "clippy",
        "clippy-wasm",
        "arch",
        "rust-tests",
        "rust-slow",
        "chromium",
        "chart-type-keyboard",
        "chart-type-pdf",
        "data-integrity",
        "visual-matrix",
        "captures",
        "cross-style",
        "disclosure-probe",
        "label-truth",
        "geometry",
        "parallel-shaders",
        "motion",
        "report-motion",
        "exports",
        "contract",
        "journeys",
        "journeys-full"
      ],
      "commands": {
        "chromium": [
          "scripts/verify-browser.mjs",
          "scripts/verify-flagship.mjs",
          "scripts/verify-figure-expand.mjs",
          "scripts/verify-chart-keyboard.mjs",
          "scripts/verify-facet-text.mjs",
          "scripts/verify-chart-readouts.mjs",
          "scripts/verify-readout-placement.mjs",
          "scripts/verify-wedge-readouts.mjs",
          "scripts/verify-chord-readouts.mjs",
          "scripts/verify-funnel-readouts.mjs",
          "scripts/verify-point-modes.mjs",
          "scripts/verify-chart-interaction.mjs",
          "scripts/verify-chart-feedback.mjs",
          "scripts/verify-report-runtime.mjs",
          "scripts/verify-docs.mjs"
        ]
      }
    },
    {
      "name": "landing and documentation stylesheet",
      "paths": [
        "assets/site.css"
      ],
      "steps": [
        "chromium",
        "site",
        "captures"
      ],
      "commands": {
        "chromium": [
          "scripts/verify-browser.mjs",
          "scripts/verify-flagship.mjs",
          "scripts/verify-docs.mjs"
        ]
      }
    },
    {
      "name": "landing page",
      "paths": [
        "assets/landing/",
        "crates/richview-site/src/browser/voices.rs"
      ],
      "steps": [
        "chromium",
        "site",
        "captures"
      ],
      "commands": {
        "chromium": [
          "scripts/verify-browser.mjs"
        ]
      }
    },
    {
      "name": "shared site header and footer",
      "paths": [
        "crates/richview-build/src/chrome.rs"
      ],
      "steps": [
        "chromium",
        "site",
        "captures"
      ],
      "commands": {
        "chromium": [
          "scripts/verify-browser.mjs",
          "scripts/verify-flagship.mjs",
          "scripts/verify-docs.mjs"
        ]
      }
    },
    {
      "name": "browser verification script",
      "paths": [
        "scripts/verify-browser.mjs"
      ],
      "steps": [
        "chromium"
      ],
      "commands": {
        "chromium": [
          "scripts/verify-browser.mjs"
        ]
      }
    },
    {
      "name": "site appearance",
      "paths": [
        "assets/"
      ],
      "steps": [
        "rust-tests",
        "rust-slow",
        "chromium",
        "chart-type-keyboard",
        "chart-type-pdf",
        "theme-switch",
        "visual-matrix",
        "captures",
        "a11y",
        "site",
        "cross-style",
        "no-js",
        "motion",
        "report-motion",
        "exports"
      ],
      "except": [
        "assets/site.css",
        "assets/landing/"
      ]
    },
    {
      "name": "browser runtime",
      "paths": [
        "crates/richview-site/",
        "crates/richview-runtime/"
      ],
      "steps": [
        "fmt",
        "clippy",
        "clippy-wasm",
        "arch",
        "rust-tests",
        "rust-slow",
        "chromium",
        "chart-type-keyboard",
        "chart-type-pdf",
        "data-integrity",
        "theme-switch",
        "visual-matrix",
        "captures",
        "a11y",
        "site",
        "cross-style",
        "disclosure-probe",
        "label-truth",
        "geometry",
        "parallel-shaders",
        "motion",
        "report-motion",
        "no-js",
        "contract",
        "exports"
      ],
      "except": [
        "crates/richview-site/src/browser/voices.rs"
      ]
    },
    {
      "name": "format and rendering",
      "paths": [
        "crates/richview-core/"
      ],
      "steps": [
        "fmt",
        "clippy",
        "clippy-wasm",
        "arch",
        "rust-tests",
        "rust-slow",
        "docs-match",
        "chromium",
        "chart-type-keyboard",
        "chart-type-pdf",
        "data-integrity",
        "theme-switch",
        "visual-matrix",
        "captures",
        "surface",
        "golden",
        "hostile",
        "a11y",
        "site",
        "cross-style",
        "disclosure-probe",
        "label-truth",
        "geometry",
        "parallel-shaders",
        "motion",
        "report-motion",
        "no-js",
        "contract",
        "exports",
        "journeys",
        "journeys-full"
      ]
    },
    {
      "name": "host and editor",
      "paths": [
        "crates/richview-app/",
        "crates/richview-editor/",
        "packages/vscode/"
      ],
      "steps": [
        "fmt",
        "clippy",
        "clippy-wasm",
        "arch",
        "rust-tests",
        "rust-slow",
        "docs-match",
        "host",
        "chromium",
        "surface",
        "golden",
        "hostile",
        "journeys",
        "journeys-full",
        "contract",
        "packaging",
        "vscode"
      ]
