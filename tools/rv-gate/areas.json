      ]
    },
    {
      "name": "spec documentation contract",
      "paths": [
        "docs/RMD-SPEC.md"
      ],
      "steps": [
        "docs-match"
      ]
    },
    {
      "name": "lockdown sources",
      "paths": [
        "docs/lockdown/"
      ],
      "steps": [
        "tool-tests"
      ]
    }
  ]
