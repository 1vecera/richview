      "paths": [
        "crates/richview-publish/",
        "cloudflare/publish/",
        "publications/",
        "crates/richview-publish-server/"
      ],
      "steps": [
        "fmt",
        "clippy",
        "clippy-wasm",
        "arch",
        "rust-tests",
        "rust-slow",
        "publish-tests",
        "chromium",
        "journeys-full",
        "hosted-smoke"
      ]
    },
    {
      "name": "gate tools",
      "paths": [
        "tools/rv-gate/",
        "tools/lockdown-app/",
