        "exports",
        "assets",
        "packaging",
        "vscode",
        "voiceover",
        "fresh-agent",
        "hosted-smoke",
        "audit"
      ]
    },
    {
      "name": "documentation contract inputs",
      "paths": [
        "AGENTS.md",
        "README.md",
        "CLAUDE.md",
        ".claude/rules/",
        "skill/SKILL.md",
        "docs/guide/",
        "docs/public/"
      ],
      "steps": [
        "docs-match"
      ]
    },
    {
      "name": "golden regression inputs",
      "paths": [
        "benchmarks/chart-regression/",
        "docs/public/index.md"
      ],
      "steps": [
        "golden"
      ]
    },
    {
      "name": "dependency policy",
      "paths": [
        "deny.toml"
      ],
      "steps": [
        "deps"
      ]
    },
    {
      "name": "browser dependency lock",
      "paths": [
        "package-lock.json",
        "package.json"
      ],
      "steps": [
        "pins",
        "deps",
        "chromium"
      ]
    },
    {
      "name": "publish dependency lock",
      "paths": [
        "cloudflare/publish/package-lock.json"
