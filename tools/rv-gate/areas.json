      "paths": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/"
      ],
      "steps": [
        "pins",
        "entrypoints",
        "fmt",
        "clippy",
        "clippy-wasm",
        "arch",
        "secrets",
        "rust-tests",
        "tool-tests",
        "publish-tests",
        "build",
        "rust-slow",
        "host",
        "chromium",
        "chart-type-keyboard",
        "chart-type-pdf",
        "data-integrity",
        "theme-switch",
        "visual-matrix",
        "captures",
        "surface",
        "fonts",
        "docs-match",
        "golden",
