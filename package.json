{
	"name": "richview",
	"version": "3.1.0",
	"private": true,
	"description": "Rust Rich Markdown product with generated host facades, verification and editor packaging.",
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/vscode"
	],
	"scripts": {
		"build": "cargo run --release --locked -p richview-build",
		"test": "cargo test --workspace --locked",
		"lint": "cargo fmt --all --check",
		"verify:browser": "node scripts/verify-browser.ts",
		"verify:galleries": "node scripts/verify-galleries.mjs",
		"verify:native": "node scripts/verify-native.ts",
		"verify:editor": "node scripts/verify-editor.cts",
		"verify:interest": "node scripts/verify-cloudflare.ts",
		"typecheck": "tsc --noEmit"
	},
	"overrides": {
		"minimatch": "^11.0.3"
	},
	"devDependencies": {
		"@types/node": "26.5.0",
		"@types/vscode": "1.90.0",
		"@vscode/test-electron": "3.1.0",
		"axe-core": "^4.14.0",
		"jose": "6.2.12",
		"playwright": "1.65.0",
		"typescript": "5.9.3",
		"wrangler": "4.154.0"
	}
}
