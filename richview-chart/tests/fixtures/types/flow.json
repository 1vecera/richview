{
 "spec": {
  "type": "flow",
  "title": "Nothing is written until every check passes",
  "subtitle": "The nightly import. A failed check ends the run before anything is written; the dashed line waits and asks again.",
  "nodes": [
   {
    "title": "Nightly run starts",
    "kind": "start"
   },
   {
    "id": "fresh",
    "title": "New files since the last run?",
    "kind": "decision"
   },
   {
    "id": "wait",
    "title": "Wait and look again",
    "lines": "every 15 minutes, four times at most;\nthen the alert\n",
    "tone": "muted"
   },
   {
    "id": "load",
    "title": "Load the new files",
    "lines": "parse CSV and JSON;\nreject rows without an id\n"
   },
   {
    "id": "checks",
    "title": "Run the checks",
    "lines": "row counts, ranges, duplicates;\nresults kept in run_checks\n"
   },
   {
    "id": "failed",
    "title": "Any check failed?",
    "kind": "decision"
   },
   {
    "id": "schema",
    "title": "Schema as yesterday?",
    "kind": "decision"
   },
   {
    "id": "write",
    "title": "Write the tables",
    "lines": "replace today's partition"
   },
   {
    "id": "totals",
    "title": "Refresh the summaries",
    "lines": "one row per region and day"
   },
   {
    "id": "stop",
    "title": "Run fails",
    "lines": "nothing written;\nthe alert names the check\n",
    "tone": "alert"
   },
   {
    "id": "publish",
    "title": "Publish on?",
    "kind": "decision"
   },
   {
    "id": "extract",
    "title": "Dashboard extract",
    "kind": "object",
    "lines": "orders.parquet,\nthen _MANIFEST last\n"
   },
   {
    "id": "done",
    "title": "Run ends",
    "kind": "end"
   }
  ],
  "groups": [
   {
    "label": "One job · checks before any write",
    "nodes": [
     "checks",
     "failed",
     "schema",
     "write",
     "totals",
     "stop"
    ]
   }
  ],
  "edges": [
   "Nightly run starts -> fresh",
   "fresh -> load: yes",
   "fresh -> wait: no",
   "wait ..> fresh: look again",
   "load -> checks: new rows",
   "checks -> failed",
   "failed -> schema: no",
   {
    "edge": "failed -> stop: yes",
    "tone": "alert"
   },
   "schema -> write: yes",
   {
    "edge": "schema -> stop: no",
    "tone": "alert"
   },
   "write -> totals",
   "totals -> publish",
   "publish -> extract: yes",
   "publish -> done: no",
   "extract -> done"
  ]
 },
