diff --git a/richview-chart/tests/heatmap_cell_values.rs b/richview-chart/tests/heatmap_cell_values.rs
index bbe4f31..fafd552 100644
--- a/richview-chart/tests/heatmap_cell_values.rs
+++ b/richview-chart/tests/heatmap_cell_values.rs
@@ -68,3 +68,63 @@ fn heatmap_cell_units_convert_once_and_keep_the_existing_fit_limit() {
         ["0 mol/s", "1.00e-12 mol/s", "2.00e-12 mol/s"]
     );
