+
+#[test]
+fn expanded_cell_values_yield_only_to_emitted_annotation_ink() {
+    let rows = vec![
+        json!({"x":"A","y":"Now","value":1e-12}),
+        json!({"x":"B","y":"Now","value":2e-12}),
+        json!({"x":"C","y":"Now","value":0}),
+        json!({"x":"D","y":"Now","value":7}),
+        json!({"x":"A","y":"Later","value":3e-12}),
+        json!({"x":"B","y":"Later","value":4e-12}),
+        json!({"x":"C","y":"Later","value":0}),
+        json!({"x":"D","y":"Later","value":8}),
+    ];
+    let base = json!({"type":"heatmap","encoding":{"x":"x","y":"y","color":"value"}});
+    let plain = render_rmd_chart(&base, &rows, 720.0, "scientific");
+    for kind in ["point", "text"] {
+        for rotate in [0, 45, 90, 180] {
+            let mut chart = base.clone();
+            chart["annotations"] =
+                json!([{"kind":kind,"at":{"x":"A","y":"Now"},"text":"First reading","rotate":rotate}]);
+            let out = render_rmd_chart(&chart, &rows, 720.0, "scientific");
+            let values = labels(&out.svg);
+            if kind == "point" {
+                assert!(!values.iter().any(|s| s == "1.00e-12"), "{kind} {rotate}: {values:?}");
+            } else {
+                // This sibling drops optional text when the full heatmap leaves it no room.
+                assert!(values.iter().any(|s| s == "1.00e-12"), "{kind} {rotate}: {values:?}");
+                assert!(
+                    out.diagnostics["droppedLabels"]
+                        .as_array()
+                        .unwrap()
+                        .iter()
+                        .any(|l| l["text"] == "First reading")
+                );
+            }
+            assert!(values.iter().any(|s| s == "4.00e-12"), "{kind} {rotate}: {values:?}");
+            assert_eq!(values.iter().filter(|s| *s == "0").count(), 2);
+            assert!(values.iter().any(|s| s == "7") && values.iter().any(|s| s == "8"));
+            assert_eq!(out.hit_points, plain.hit_points);
+            assert_eq!(out.runtime.as_ref().unwrap()["chart"]["data"]["inline"], json!(rows));
+        }
+    }
+    for annotation in [
+        json!({"kind":"band","from":{"y":"Now"},"to":{"y":"Later"},"text":""}),
+        json!({"kind":"text","at":{"x":"Unknown","y":"Now"},"text":"Unresolved"}),
+    ] {
+        let mut chart = base.clone();
+        chart["annotations"] = json!([annotation]);
+        assert_eq!(
+            labels(&render_rmd_chart(&chart, &rows, 720.0, "scientific").svg),
+            labels(&plain.svg)
+        );
+    }
+    let mut chart = base;
+    chart["annotations"] = json!([{"kind":"line","at":{"y":"Now"},"text":""}]);
+    assert_eq!(
+        labels(&render_rmd_chart(&chart, &rows, 720.0, "scientific").svg),
+        ["0", "7", "3.00e-12", "4.00e-12", "0", "8"]
+    );
+}
