diff --git a/richview-chart/tests/calendar_label_diagnostics.rs b/richview-chart/tests/calendar_label_diagnostics.rs
index d5d5603..fc5cc13 100644
--- a/richview-chart/tests/calendar_label_diagnostics.rs
+++ b/richview-chart/tests/calendar_label_diagnostics.rs
@@ -34,3 +34,33 @@ fn calendar_diagnostics_follow_shifted_endpoint_labels() {
         }
     }
 }
+
+#[test]
+fn calendar_value_labels_fit_inside_the_native_frame() {
+    for scale in [1.0, 1e-12, 1e20] {
+        let rows = vec![
+            json!({"date":"2026-01-01","value":scale}),
+            json!({"date":"2026-01-02","value":2.0*scale}),
+            json!({"date":"2026-01-03","value":3.0*scale}),
+        ];
+        for format in ["currency", "percent"] {
+            let chart = json!({
+                "type":"line", "encoding":{"x":"date","y":"value"},
+                "axes":{"y":{"format":format}},
+            });
+            for width in [240.0, 320.0, 720.0] {
+                let out = render_rmd_chart(&chart, &rows, width, "scientific");
+                assert!(
+                    out.diagnostics["checks"]
+                        .as_array()
+                        .unwrap()
+                        .iter()
+                        .all(|check| check["kind"] != "clipping"),
+                    "{format} scale {scale} at {width}px: {}",
+                    out.diagnostics
+                );
+                assert_eq!(out.runtime.as_ref().unwrap()["chart"]["data"]["inline"], json!(rows));
+            }
+        }
+    }
+}
