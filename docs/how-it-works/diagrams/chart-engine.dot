digraph chart_engine {
  graph [rankdir=TB, bgcolor="transparent", pad=0.12, nodesep=0.30, ranksep=0.40];
  node [shape=box, style="rounded,filled", color="#474747", fontcolor="#333333", fillcolor="white", fontname="Helvetica", fontsize=12, margin="0.13,0.08"];
  edge [color="#474747", fontcolor="#333333", fontname="Helvetica", fontsize=11, arrowsize=0.7];
  render [label="Report renderer\nResolved rows"];
  reader [label="Report reader\nEmbedded rows"];
  layout [label="Chart engine\nLay out at requested width", color="#196965", fontcolor="#196965", penwidth=1.6];
  model [label="Geometry\nMarks, labels and checks"];
  checks [label="Report diagnostics\nand figure frame"];
  svg [label="Vector drawing\nfor PDF"];
  screen [label="Browser drawing\nand selection"];
  render -> layout;
  reader -> layout;
  layout -> model;
  model -> checks;
  model -> svg;
  model -> screen;
}
