digraph core {
  graph [rankdir=TB, bgcolor="transparent", pad=0.12, nodesep=0.30, ranksep=0.40];
  node [shape=box, style="rounded,filled", color="#474747", fontcolor="#333333", fillcolor="white", fontname="Helvetica", fontsize=12, margin="0.13,0.08"];
  edge [color="#474747", fontcolor="#333333", fontname="Helvetica", fontsize=11, arrowsize=0.7];
  parsed [label="Parsed Rich Markdown"];
  inputs [label="Resources and reader code"];
  render [label="Report renderer\nApply style and resolve blocks", color="#196965", fontcolor="#196965", penwidth=1.6];
  layout [label="Chart engine\nMeasure figures"];
  body [label="Render Markdown\nand other elements"];
  page [label="Assemble HTML, chart data\nand diagnostics"];
  parsed -> render;
  inputs -> render;
  render -> layout;
  render -> body;
  layout -> page;
  body -> page;
}
