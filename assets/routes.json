{
  "$comment": "The public route map of richview.ai (FEA-SF-46). The build keeps only the top-level names under `keep`; the site gate requests every route under `serve`, checks `redirect`, and expects 404 for everything under `gone`.",
  "keep": [
    "_headers",
    "_redirects",
    "robots.txt",
    "llms.txt",
    "install.html",
    "skill",
    "index.html",
    "about.html",
    "impressum.html",
    "privacy.html",
    "terms.html",
    "404.html",
    "licenses.html",
    "third-party-notices.txt",
    "playground.html",
    "site.css",
    "legal.css",
    "playground.css",
    "richview-fonts.css",
    "fonts-math.css",
    "bootstrap.js",
    "worker.js",
    "report-runtime.js",
    "richview_site.js",
    "richview_site_bg.wasm",
    "richview_runtime.js",
    "richview_runtime_bg.wasm",
    "richview_runtime_bg.wasm.gz",
    "fonts",
    "landing",
    "share",
    "docs",
    "showcase",
    "examples",
    "richview_docs.js",
    "richview_docs_bg.wasm",
    "richview_docs_bg.wasm.gz"
  ],
  "serve": [
    "/fonts-math.css",
    "/",
    "/showcase/openai-vs-anthropic/",
    "/showcase/openai-vs-anthropic/report.rmd",
    "/docs/",
    "/docs/charts",
    "/docs/reference",
    "/docs/examples/co2-mauna-loa-monthly/",
    "/docs/examples/us-cpi-components/",
    "/docs/examples/de-power-15min/",
    "/playground",
    "/about",
    "/impressum",
    "/privacy",
    "/terms",
    "/licenses",
    "/third-party-notices.txt",
    "/robots.txt",
    "/llms.txt",
    "/skill/SKILL.md"
  ],
  "install": [
    "/install"
  ],
  "redirect": {
    "/showcase": "/showcase/openai-vs-anthropic/",
    "/app": "/playground",
    "/charts/": "/docs/charts",
    "/chart-gallery/": "/docs/charts",
    "/about.html": "/about",
    "/impressum.html": "/impressum",
    "/privacy.html": "/privacy",
    "/licenses.html": "/licenses",
    "/terms.html": "/terms"
  },
  "gone": [
    "/reel/",
    "/landing/",
    "/landing/index.html",
    "/landing/generated/",
    "/typography/",
    "/assets/_headers",
    "/bindings/core/index.browser.js",
    "/richview_site.d.ts",
    "/richview_web.js",
    "/chart-data/",
    "/showcase/chart-review/",
    "/showcase/themes.json",
    "/showcase/openai-vs-anthropic/source-data.json",
    "/showcase/openai-vs-anthropic/diagnostics.json",
    "/api/other",
    "/install.sh",
    "/install-release.json",
    "/downloads/"
  ]
}
